# ---- Copy to .env and fill in. Never commit .env. ----

# Gnani.ai Speech APIs (see docs.gnani.ai). Key header: X-API-Key-ID
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# STT model name (challenge requires naming every model used)
GNANI_STT_MODEL=gnani-prisma-v2.5
# TTS model: timbre-v3.0 (13 voices, each speaks all 10 languages) or timbre-v2.5
GNANI_TTS_MODEL=timbre-v3.0
# Voice names for the configured TTS model (timbre-v3.0 examples below)
GNANI_TTS_VOICE_FEMALE=Shivani
GNANI_TTS_VOICE_MALE=Avinash
# Demo bot reply voice
GNANI_BOT_VOICE=Kalpana
# Max concurrent requests to Gnani (some plans allow only 1 active request; 429 -> backoff)
GNANI_CONCURRENCY=1

# LLM used for personas, caller turns and judge (any OpenAI-compatible /chat/completions API).
# Configured for OpenRouter free models by default:
#   - Key from https://openrouter.ai/keys  (looks like sk-or-v1-...)
#   - Pick any model with the :free suffix: https://openrouter.ai/models?max_price=0
#   - Free tier limits: ~20 requests/min + daily cap per model; a run makes ~10 LLM
#     calls per call (persona gen + up to 10 caller turns + 1 judge), so pace suites
#     or rotate models.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# 1 = deterministic mock LLM for development/testing with zero API calls
LLM_MOCK=0

# VoiceQA runtime
VOICEQA_CREDIT_LIMIT=800
VOICEQA_MAX_CONCURRENT_CALLS=5
VOICEQA_MAX_TURNS=10
VOICEQA_CALL_TIMEOUT_S=180
VOICEQA_DB_PATH=data/voiceqa.db
VOICEQA_AUDIO_DIR=data/audio
VOICEQA_NOISE_DIR=data/noise
VOICEQA_HOST=127.0.0.1
VOICEQA_PORT=8000

# App URL sent to OpenRouter as HTTP-Referer (used for free-model ranking/attribution; ignored by other providers)
VOICEQA_APP_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
